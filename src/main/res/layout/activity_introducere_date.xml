<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="409dp"
    android:layout_height="729dp"
    android:orientation="vertical"
    tools:layout_editor_absoluteX="1dp"
    tools:layout_editor_absoluteY="1dp">


    <Spinner
        android:id="@+id/spinnerCuloare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip marmura"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tipMarmura_ET"
        android:inputType="text"
        android:hint="@string/introduceti_tipul_marmurii" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pret marmura"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/pretMarmura_ET"
        android:inputType="numberDecimal"
        android:hint="@string/introduceti_pretul_marmurii"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finisaj"/>"

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/finisaj_RG">

            <RadioButton
                android:id="@+id/radioLucios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucios" />
            <RadioButton
            android:id="@+id/radioMat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mat" />
</RadioGroup>



    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/inStoc_CB"
        android:text="In stoc"/>

    <Button
        android:id="@+id/buttonAdauga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adauga marmura"
        android:onClick="adaugaMarmura"
        />


</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".IntroducereDate">

    <Spinner
        android:id="@+id/spinnerCuloare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip marmura" />

    <EditText
        android:id="@+id/tipMarmura_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introduceti_tipul_marmurii"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pret marmura" />

    <EditText
        android:id="@+id/pretMarmura_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introduceti_pretul_marmurii"
        android:inputType="numberDecimal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finisaj" />

    <RadioGroup
        android:id="@+id/finisaj_RG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioLucios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lucios" />

        <RadioButton
            android:id="@+id/radioMat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mat" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/inStoc_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="In stoc" />

    <Button
        android:id="@+id/buttonAdauga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="adaugaMarmura"
        android:text="Adauga marmura" />

</LinearLayout>